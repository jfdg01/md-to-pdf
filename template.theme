# md-to-pdf theme template
# =========================
# Copy this file, edit the values, and point a document at it from its front
# matter:
#
#     ---
#     title: My report
#     theme: template.theme
#     ---
#
# Every key is optional and shown here at its built-in default, so this template
# renders identically to using no theme at all — change a value to override that
# default for every document using the theme.
#
# Precedence: built-in defaults < this .theme < the document's own front matter.
# A `#` starts a comment (the whole line, or inline after a value). Spanish
# aliases work for every key (see the README). The `---` delimiters are optional.


# ── Identity ─────────────────────────────────────────────────────────────────
# Normally set per-document, not in a shared theme. Uncomment to share.
# title:        Document title
# subtitle:     An optional subtitle
# comment:      Free extra line (date, course, note…)
# author:       Your Name
# logo:         images/cover.png      # any image path, or `none`
# bibliography: refs.bib              # path to a BibTeX .bib file


# ── Language ─────────────────────────────────────────────────────────────────
locale: es                            # es (default) | en


# ── Sections & table of contents ─────────────────────────────────────────────
numbering: true                       # auto-number sections: true | false
toc_depth: 4                          # deepest TOC level: 3 (###) | 4 (####) | 5


# ── Page geometry ────────────────────────────────────────────────────────────
page_size:   a4                       # a4 (default), a5, a3, letter, legal, b5…
orientation: portrait                 # portrait | landscape
margins:     1.15in 0.85in 0.95in 0.85in   # CSS order: top right bottom left
# Or set individual sides instead of `margins`:
# margin_top:    1.15in
# margin_right:  0.85in
# margin_bottom: 0.95in
# margin_left:   0.85in


# ── Code highlighting ────────────────────────────────────────────────────────
code_theme: custom                    # custom (default) or any Pygments theme:
                                      # monokai, dracula, nord, github-dark…


# ── Citations ────────────────────────────────────────────────────────────────
citation_style: numeric               # numeric ([1]) | author-year ((Smith, 2020))


# ── Font sizes ───────────────────────────────────────────────────────────────
# A bare number is points (14 -> 14pt); any CSS unit also works (1.2em, 12px).
text_size:          14                # body text
title_size:         27                # cover title
subtitle_size:      16.5              # cover subtitle
comment_size:       13                # cover comment line
author_size:        14                # cover author (footer uses footer_size)
h1_size:            24.5              # body headings, per level
h2_size:            18.5
h3_size:            15
h4_size:            13.5
h5_size:            12.5
# h6_size:          12                # h6 has no built-in size; uncomment to set
code_size:          11.5              # code blocks and inline code
table_size:         13                # tables
caption_size:       12                # figure/table captions and code labels
index_heading_size: 18.5              # "Contents" / "List of …" page headings
header_size:        9.5               # running header (title · subtitle)
footer_size:        9.5               # running footer (author) and page number


# ── Table-of-contents line sizes ─────────────────────────────────────────────
# toc_size sets every level at once; toc1_size…toc4_size override one level
# (1 = top-level ## entries, 2 = ###, 3 = ####, 4 = #####). Per-level wins over
# toc_size; deeper levels inherit level 4. toc_size also sizes the index lists.
# toc_size: 11
toc1_size: 12
toc2_size: 11
toc3_size: 10.5
toc4_size: 10
